# ParkWiz edge box — copy to edge/.env and fill in on the box itself.
# edge/.env is git-ignored and must never be committed, pasted into an issue,
# or sent over email/WhatsApp. If one of these values is ever exposed, the fix
# is the camera's own password change, not a ParkWiz change.
#
#   cp edge/.env.example edge/.env && chmod 600 edge/.env

# Read-only camera/NVR user. "Read-only" is not a formality: this user must not
# be able to pan/tilt, change settings, delete footage or add users. Hikvision:
# user type "Operator" with only Live View + Playback. Dahua: a group with
# "Monitor" rights only.
CAM_USER=parkwiz_ro
CAM_PASSWORD=
CAM_HOST=192.168.1.64

# Frigate reads the go2rtc restream, so it needs no camera credentials. This is
# here only if you choose to point Frigate straight at a camera instead.
FRIGATE_RTSP_PASSWORD=

# Frigate's own web UI (bound to 127.0.0.1 in docker-compose.yml). Set this and
# Frigate requires a login before showing a single frame.
FRIGATE_ADMIN_PASSWORD=

# The lot id the bridge stamps on every message. Must match the lot in
# edge/bridge/config.json and in the ParkWiz page.
PARKWIZ_LOT=atidim
